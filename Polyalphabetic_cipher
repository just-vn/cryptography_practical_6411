def encrypt(text, key):
    result = ""
    j = 0

    for ch in text:
        if ch.isalpha():
            result += chr((ord(ch.upper()) - 65 +
                           ord(key[j % len(key)].upper()) - 65) % 26 + 65)
            j += 1
        else:
            result += ch

    return result


def decrypt(text, key):
    result = ""
    j = 0

    for ch in text:
        if ch.isalpha():
            result += chr((ord(ch) - 65 -
                           ord(key[j % len(key)].upper()) + 65) % 26 + 65)
            j += 1
        else:
            result += ch

    return result


text = input()
key = input()

encrypted = encrypt(text, key)
print("Encrypted text:", encrypted)

decrypted = decrypt(encrypted, key)
print("Decrypted text:", decrypted)

